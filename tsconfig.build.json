{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "removeComments": true,
    "allowImportingTsExtensions": false,
    "declaration": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/_*.ts"
  ]
}
